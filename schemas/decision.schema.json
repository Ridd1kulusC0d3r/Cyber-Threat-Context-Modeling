{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ridd1kulusC0d3r/Cyber-Threat-Context-Modeling/schemas/decision.schema.json",
  "title": "TCE Decision",
  "type": "object",
  "required": [
    "version",
    "decision"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "decision": {
      "type": "object",
      "required": [
        "id",
        "title",
        "statement",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^DEC-[A-Za-z0-9._-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "proposed",
            "approved",
            "implemented",
            "rejected",
            "superseded"
          ]
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
