{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ridd1kulusC0d3r/Cyber-Threat-Context-Modeling/schemas/threat-scenario.schema.json",
  "title": "TCE Threat Scenario",
  "type": "object",
  "required": [
    "version",
    "scenario"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "scenario": {
      "type": "object",
      "required": [
        "id",
        "title",
        "objective",
        "target_crown_jewels",
        "priority",
        "confidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^TS-[A-Za-z0-9._-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "target_crown_jewels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "initial_conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "preconditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "attack_techniques": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$"
          }
        },
        "priority": {
          "type": "object",
          "required": [
            "crown_jewel_criticality",
            "threat_relevance",
            "attack_path_feasibility",
            "exposure",
            "control_weakness",
            "detection_gap"
          ],
          "properties": {
            "crown_jewel_criticality": {
              "type": "number",
              "minimum": 0,
              "maximum": 5
            },
            "threat_relevance": {
              "type": "number",
              "minimum": 0,
              "maximum": 5
            },
            "attack_path_feasibility": {
              "type": "number",
              "minimum": 0,
              "maximum": 5
            },
            "exposure": {
              "type": "number",
              "minimum": 0,
              "maximum": 5
            },
            "control_weakness": {
              "type": "number",
              "minimum": 0,
              "maximum": 5
            },
            "detection_gap": {
              "type": "number",
              "minimum": 0,
              "maximum": 5
            },
            "calculated_score": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 5
            },
            "band": {
              "type": "string",
              "enum": [
                "",
                "P0",
                "P1",
                "P2",
                "P3"
              ]
            }
          },
          "additionalProperties": true
        },
        "confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low",
            "unknown"
          ]
        },
        "owner": {
          "type": "string"
        },
        "review_date": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
